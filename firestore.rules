rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared access model ─────────────────────────────────────────────────
    // One users/{uid} doc per account (id = Firebase Auth uid), shared by every app under
    // showmanager. isManager is the portal-level role — manages users/access for every app and
    // implicitly passes every hasAccess() check below. Everyone else only gets in where their
    // own access.{key} flag is true.
    function isManager() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isManager == true;
    }
    function hasAccess(key) {
      return isManager() || (
        request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.access[key] == true
      );
    }

    // Accounts are provisioned by a manager via the createUser Cloud Function (Admin SDK,
    // bypasses these rules) — no client-side registration, so create is denied outright here. A
    // manager can update anyone's doc (name/access/isManager, portal → Users); the one thing a
    // non-manager can do to their own doc is clear mustChangePassword once they've set their own
    // password — never set it, and never touch any other field in the same write.
    match /users/{uid} {
      allow create: if false;
      allow read: if request.auth != null && (request.auth.uid == uid || isManager());
      allow update: if isManager() ||
        (request.auth != null && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
         request.resource.data.mustChangePassword == false);
    }

    // ── Expenses ─────────────────────────────────────────────────────────────
    match /expenses_shows/{id} {
      allow read: if true; // entry app needs the list before login even finishes rendering
      allow write: if hasAccess('expensesAdmin');
    }
    match /expenses_config/{id} {
      allow read, write: if hasAccess('expensesAdmin');
    }
    // Sequential reference numbers (app.js's submitAllBtn) — same shape as showdrinks_counters,
    // incremented in a transaction by whoever's actually allowed to submit an expense.
    match /expenses_counters/{id} {
      allow read, write: if hasAccess('expensesAdmin') || (request.auth != null && hasAccess('expenses'));
    }
    // A manager/expensesAdmin can always submit; an approved player (access.expenses) can submit
    // only as themselves (userEmail must match their own verified auth email). Reading is scoped
    // the same way. expensesAdmin can update any field (mark paid, etc.) or delete; the
    // submitter can only ever touch receiptPaths on their own doc (add/replace a forgotten or
    // extra receipt photo after the fact) — everything else (amount, paid, description...) stays
    // locked to expensesAdmin even for the doc's own owner. A receipt is mandatory on every
    // expense — receiptPaths must be a non-empty array — enforced here too, not just in app.js's
    // own form validation, since this is the actual security boundary.
    match /expenses/{id} {
      allow create: if request.resource.data.receiptPaths.size() > 0 && (hasAccess('expensesAdmin') ||
        (request.auth != null && hasAccess('expenses') && request.resource.data.userEmail == request.auth.token.email));
      allow read: if hasAccess('expensesAdmin') || (request.auth != null && resource.data.userEmail == request.auth.token.email);
      allow update: if hasAccess('expensesAdmin') ||
        (request.auth != null && resource.data.userEmail == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptPaths']));
      allow delete: if hasAccess('expensesAdmin');
    }

    // ── ShowDrinks ───────────────────────────────────────────────────────────
    // Customer-facing paths (order.js) stay open to anonymous users, same as before — showdrinks
    // never required a login for placing/checking an order. Admin-only collections now check
    // access.showdrinksAdmin instead of the old bare `request.auth != null`.
    match /showdrinks_shows/{id} {
      allow read: if true;
      allow write: if hasAccess('showdrinksAdmin');
    }
    match /showdrinks_config/{doc} {
      allow read: if true;
      allow write: if hasAccess('showdrinksAdmin');
    }
    // SumUp merchant code/API key (system default in 'system', per-show overrides in 'show_<id>') —
    // kept out of showdrinks_config/showdrinks_shows because those are publicly readable. Only the
    // admin UI and Cloud Functions (admin SDK, bypasses rules) ever touch this.
    match /showdrinks_secrets/{doc} {
      allow read, write: if hasAccess('showdrinksAdmin') ||
        (doc.matches('paylink_.*') && hasAccess('showplanner')); // payment links are managed from ShowPlanner
    }
    // Payment links (fixed-price single items, e.g. rehearsal subs): the PWA reads title/amount
    // publicly; their SumUp credentials live in showdrinks_secrets/paylink_<id>. Managed from ShowPlanner's
    // show "Payment Links" sub-tab. Payments are
    // written only by Cloud Functions (admin SDK) and read by the admin UI.
    match /showdrinks_payLinks/{id} {
      allow read: if true;
      allow write: if hasAccess('showdrinksAdmin') || hasAccess('showplanner');
    }
    match /showdrinks_payments/{id} {
      allow read: if hasAccess('showdrinksAdmin') || hasAccess('showplanner');
      allow write: if hasAccess('showdrinksAdmin');
    }
    match /showdrinks_menuItems/{id} {
      allow read: if true;
      allow write: if hasAccess('showdrinksAdmin');
    }
    match /showdrinks_locations/{id} {
      allow read, write: if hasAccess('showdrinksAdmin'); // the PWA never reads this collection directly
    }
    match /showdrinks_posGrids/{id} {
      allow read: if true;
      allow write: if hasAccess('showdrinksAdmin');
    }
    // Stock take (Bar Manager): cost prices + counts, kept off the publicly-readable menuItems.
    match /showdrinks_stock/{id} {
      allow read, write: if hasAccess('showdrinksAdmin');
    }
    // Organisations (Pirton Players, Film Club...) that hold shares of the stock.
    match /showdrinks_orgs/{id} {
      allow read, write: if hasAccess('showdrinksAdmin');
    }
    // Log of every stock addition (restock received / + - adjustments), shown on the Reports page.
    match /showdrinks_deliveries/{id} {
      allow read, write: if hasAccess('showdrinksAdmin');
    }
    match /showdrinks_stockTakes/{id} {
      allow read, write: if hasAccess('showdrinksAdmin');
    }
    match /showdrinks_counters/{id} {
      allow read, write: if true; // anonymous customers increment these when placing an order
    }
    match /showdrinks_orders/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if hasAccess('showdrinksAdmin');
    }
    // Bar Tabs POS (a bartender with only showdrinksTabsPos, not full showdrinksAdmin) needs to
    // read/write these two to take tab orders — everything else showdrinks-admin-only stays
    // showdrinksAdmin-only (editing the menu/grids/shows is not exposed to that restricted view).
    // showdrinks_tabMembers doubles as the whole suite's shared members directory — the portal's
    // and Expenses' own Add user screens read it to populate their Member picker dropdown, so
    // expensesAdmin gets read-only access too (isManager already covers the portal via
    // hasAccess('showdrinksAdmin')); ShowPlanner reads it too, to assign roles/tasks to anyone in
    // the general membership, not just accounts with their own ShowPlanner login. Only Bar Tabs
    // POS/Bar Manager can write to it.
    match /showdrinks_tabMembers/{id} {
      allow read: if hasAccess('showdrinksAdmin') || hasAccess('showdrinksTabsPos') || hasAccess('expensesAdmin') || hasAccess('showplanner');
      allow write: if hasAccess('showdrinksAdmin') || hasAccess('showdrinksTabsPos');
    }
    match /showdrinks_tabOrders/{id} {
      allow read, write: if hasAccess('showdrinksAdmin') || hasAccess('showdrinksTabsPos');
    }

    // ── ShowBudget ───────────────────────────────────────────────────────────
    match /budget_shows/{id} {
      allow read, write: if hasAccess('budget');
    }

    // ── ShowPlanner ──────────────────────────────────────────────────────────
    // New, independent app alongside ShowBudget (see shared/auth.js) — its own access key and
    // collections, no coupling to budget_shows above.
    //
    // planAccess narrows only the PLAN fields on a show (roles, roleAssignments,
    // planTemplateId) and its tasks subcollection — budget fields (fixedParams/income/spend) and
    // show identity (name/director/producer/showType) stay open to anyone with access.showplanner
    // regardless, same as budget/ today, since "the budget should remain as is" was the whole
    // point of building this as a separate app. An empty/missing planAccess map means "open to
    // everyone" — a fresh show, or any show nobody's ever restricted, is fully editable by any
    // access.showplanner account; only once a producer explicitly sets planAccess does anyone
    // else drop to read-only there.
    function showPlanEditable(show) {
      return isManager() ||
        !('planAccess' in show) || show.planAccess.size() == 0 ||
        show.planAccess[request.auth.uid] == 'edit';
    }
    function parentShowPlanEditable(showId) {
      return showPlanEditable(get(/databases/$(database)/documents/showplanner_shows/$(showId)).data);
    }
    // A task's own assignee (by uid in assigneeIds, or by holding its roleId per the parent
    // show's roleAssignments) can still update just that task's status/comments without full
    // plan-edit rights — "individual users should be able to update the status and any comments
    // assigned to their role" from the spec this was built against.
    function isTaskAssignee(showId, task) {
      let show = get(/databases/$(database)/documents/showplanner_shows/$(showId)).data;
      return request.auth != null && (
        request.auth.uid in task.assigneeIds ||
        (task.roleId != null && ('roleAssignments' in show) &&
         (task.roleId in show.roleAssignments) && request.auth.uid in show.roleAssignments[task.roleId])
      );
    }

    match /showplanner_shows/{id} {
      allow read: if hasAccess('showplanner');
      allow create, delete: if hasAccess('showplanner');
      allow update: if hasAccess('showplanner') && (
        showPlanEditable(resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'director', 'producer', 'showType', 'fixedParams', 'income', 'spend', 'isTemplate', 'copiedFrom', 'updatedAt'])
      );
    }
    match /showplanner_shows/{id}/tasks/{taskId} {
      allow read: if hasAccess('showplanner');
      allow create, delete: if hasAccess('showplanner') && parentShowPlanEditable(id);
      allow update: if hasAccess('showplanner') && (
        parentShowPlanEditable(id) ||
        (isTaskAssignee(id, resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'comments', 'updatedAt']))
      );
    }
    match /showplanner_templates/{id} {
      allow read, write: if hasAccess('showplanner');
    }

    // ── Portal ───────────────────────────────────────────────────────────────
    match /portal_config/{id} {
      allow read, write: if isManager();
    }
  }
}
